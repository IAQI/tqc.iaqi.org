function checkTypeGetField(dataHash, namePrefix) {
  var htmlReturn = "";

  var mandatory = "";
  if (dataHash.mandatory) {
    mandatory = "mandatory";
  }
  if (dataHash.type == "input") {
    htmlReturn = '<input type="text" name="' + namePrefix + dataHash.id + '" class="form-control ' + mandatory + '" maxlength="254">';
  } else if (dataHash.type == "input-date") {
    htmlReturn = '<input class="datepicker ' + mandatory + '" readonly="true" type="text" name="' + dataHash.id + '" maxlength="254" data-date-format="yyyy-mm-dd">';
  } else if (dataHash.type == "textarea") {
    htmlReturn = '<textarea class="form-control ' + mandatory + '" name="' + namePrefix + dataHash.id + '"></textarea>';
  } else if (dataHash.type == "checkbox") {
    htmlReturn = '<input type="checkbox" name="' + namePrefix + dataHash.id + '">';
  } else if (dataHash.type == "multiple-choice") {
    var fieldArray = dataHash.options.split(";")
    for (var x = 0; x < fieldArray.length; x++) {
      htmlReturn += '<input type="checkbox" name="' + namePrefix + dataHash.id + '" value="' + fieldArray[x] + '"> ' + fieldArray[x] + '<br>';
    }
  } else if (dataHash.type == "dropdown") {
    htmlReturn = "<select name='" + namePrefix + dataHash.id + "' class='form-control " + mandatory + "'>";
    var fieldArray = dataHash.options.split(";")
    for (var x = 0; x < fieldArray.length; x++) {
      htmlReturn += "<option value='" + fieldArray[x] + "'>" + fieldArray[x] + "</option>";
    }
    htmlReturn += "</select>";
  } else if (dataHash.type.match(/file.*/i)) {
    $("#uploadDialogs").append('<div id="upload_dialog_' + dataHash.id + '" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="uploadModalLabel"><div class="modal-dialog" role="document"><div class="modal-content">' +
      '<div class="modal-header"><button type="button" class="close" data-dismiss="modal">×</button><h3>Upload</h3></div>' +
      '<div class="modal-body"><iframe id="uploadFrame" src="' + eventUrlSecure + '/registration/upload?type=field&fieldid=' + dataHash.id + '" frameborder="0" height="250" width="99.6%"></iframe>' +
      '</div></div></div></div>');
    htmlReturn += '<input class="' + mandatory + '" type="hidden" name="' + namePrefix + dataHash.id + '">';
    htmlReturn += '<button type="button" class="btn btn-default" data-toggle="modal" data-target="#upload_dialog_' + dataHash.id + '" id="upload_btn_' + dataHash.id + '" onclick="return false;">Select file</button>';
  }
  return htmlReturn;
}

function submitEventForm(formId) {
  data = $("#form_" + formId).find(":input:not(.noSerialize)").serializeArray();
  if ($("#form_" + formId + " input[name=email]").val() != "") {
    if (checkMandatoryFormFields(formId)) {
      $.ajax({
        url: ("/api/" + eventVar + "/form/" + formId + "/user"),
        type: 'POST',
        data: data,
        dataType: 'json',
        success: function (response) {
          if (response.code) {
            $.when($("#form_" + formId).fadeOut()).done(function () {
              $("#form_" + formId).html('<div class="alert alert-success" role="alert"><i class="fa fa-check"></i> Form information sent successfully.</div>');
              $("#form_" + formId).fadeIn();
            });
          } else {
            $.when($("#form_" + formId).fadeOut()).done(function () {
              $("#form_" + formId).html('<div class="alert alert-danger" role="alert"><i class="fa fa-warning"></i> Error on send of the form information.</div>');
              $("#form_" + formId).fadeIn();
            });
          }
        }
      });
    } else {
      $("#form_" + formId + " #formStatus").html('<div style="margin-top: 10px;" class="alert alert-danger" role="alert"><i class="fa fa-warning"></i> Please insert all mandatory additional information.</div>');
    }
  } else {
    $("#form_" + formId + " #formStatus").html('<div style="margin-top: 10px;" class="alert alert-danger" role="alert"><i class="fa fa-warning"></i> Please insert your e-mail-address.</div>');
  }
}

function checkMandatoryFormFields(formId) {
  var fieldArray = $("#form_" + formId + " .mandatory").serializeArray();
  for (var i = 0; i < fieldArray.length; i++) {
    if (fieldArray[i].value == "") {
      return false;
    }
  };
  return true;
}
}

