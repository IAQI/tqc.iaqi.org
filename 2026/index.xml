}
.slideshow .nav.prev { left: 0.75rem; }
.slideshow .nav.next { right: 0.75rem; }
.slideshow .dots {
 position: absolute;
 bottom: 0.75rem;
 left: 50%;
 transform: translateX(-50%);
 display: flex;
 gap: 0.4rem;
